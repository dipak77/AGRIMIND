# Environment Configuration for AGRIMIND
# Copy to .env:  cp .env.example .env

ENV=local
LOG_LEVEL=INFO

# JWT — local default is embedded in Settings for ENV=local; set explicitly for staging/prod
JWT_SECRET=local-dev-secret-key-min-32-chars-long!
JWT_ALGORITHM=HS256
# AUTH_REQUIRED=true in production; false for local anonymous
AUTH_REQUIRED=false
# ALLOW_LOCAL_TOKEN_ISSUE=true  # only if ENV=production must still mint HS256

# --- Live OIDC IdP (when set, decode_token uses RS256/ES256 JWKS path) ---
# See docs/OIDC.md for Keycloak + Auth0 setup
# OIDC_ISSUER=https://keycloak.example.com/realms/agrimind
# OIDC_JWKS_URL=https://keycloak.example.com/realms/agrimind/protocol/openid-connect/certs
# OIDC_AUDIENCE=agrimind-api
# OIDC_CLIENT_ID=agrimind-gateway
# OIDC_CLIENT_SECRET=                 # confidential client; omit for public PKCE
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=http://localhost:3000/callback
# OIDC_JWKS_TTL_SECONDS=3600
# OTEL
OTEL_ENABLED=true
# OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Matches docker-compose postgres (user/password/db). psycopg accepts postgresql://;
# SQLAlchemy-style postgresql+asyncpg:// is also accepted and normalized.
POSTGRES_DSN=postgresql://agrimind:agrimind_secret_123@localhost:5432/agrimind
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
# Must match docker-compose MINIO_ROOT_PASSWORD
MINIO_SECRET_KEY=minioadmin_secret
MODEL_REGISTRY_PATH=s3://agrimind-models

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agrimind123
# Graph is seeded via POST /v1/graph/seed (or auto when empty)

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agrimind_chunks
# MEMORY_BACKEND: stub | live | auto (auto = live then stub fallback)
MEMORY_BACKEND=auto
EMBED_DIM=384
REDIS_URL=redis://localhost:6379/0
# B3 semantic retrieval cache (Redis when reachable, else in-memory)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
TEMPORAL_ADDRESS=localhost:7233
# Data plane / lakehouse
# OBJECT_STORE: auto (MinIO if up, else local_fs) | minio | local
# Prefer "local" when running without docker MinIO to skip connection probes.
LAKEHOUSE_ROOT=./data/lakehouse
OBJECT_STORE=auto
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Critical path URLs (canonical ports)
ASSISTANT_API_URL=http://localhost:8001
AGENT_ORCHESTRATOR_URL=http://localhost:8002
MEMORY_SERVICE_URL=http://localhost:8003
INFERENCE_SERVICE_URL=http://localhost:8004
# Phase D inference
# INFERENCE_MODE: auto (remote if VLLM_BASE_URL set, else sim) | sim | remote
INFERENCE_MODE=auto
# Remote OpenAI-compatible backend (vLLM / SGLang). See infra/vllm/README.md
# GPU compose (optional; not started by plain docker compose up):
#   docker compose -f docker-compose.yml -f docker-compose.vllm.yml --profile gpu up -d vllm
# Then:
#   INFERENCE_MODE=remote
#   VLLM_BASE_URL=http://localhost:8008/v1
#   VLLM_API_KEY=EMPTY
# VLLM_BASE_URL=http://localhost:8008/v1
# VLLM_API_KEY=EMPTY
# Model id served by vLLM (HF id). Smoke default is small; production uses larger models.
# Weights are NOT bundled — container downloads from Hugging Face.
# VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# DEFAULT_CLOUD_MODEL should match the model vLLM loaded when using remote mode
# DEFAULT_CLOUD_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# VLLM_IMAGE=vllm/vllm-openai:latest
# VLLM_HOST_PORT=8008
# VLLM_MAX_MODEL_LEN=2048
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HUGGING_FACE_HUB_TOKEN=
MODEL_REGISTRY_LOCAL=./data/model-registry
# Phase E flywheel feedback store
# FEEDBACK_STORE: auto | postgres | jsonl | memory
# auto = try Postgres (POSTGRES_DSN) + ensure schema; fall back to JSONL if unreachable
FEEDBACK_STORE=auto
FEEDBACK_PATH=./data/feedback/events.jsonl
# Schema migrate: uv run python -m agrimind_kernel.feedback.migrate
GRAPH_APPROVAL_PATH=./data/graph/approvals.jsonl
CANARY_STATE_PATH=./data/model-registry/canary_state.json
VISION_SERVICE_URL=http://localhost:8005
FEEDS_SERVICE_URL=http://localhost:8006

OPENWEATHER_API_KEY=
AGMARKNET_API_KEY=
