# Environment Configuration for AGRIMIND
# Copy this file to .env and update values for your environment

# General
ENV=local
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DSN=postgresql+asyncpg://agrimind:agrimind@localhost:5432/agrimind
POSTGRES_USER=agrimind
POSTGRES_PASSWORD=agrimind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrimind

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agrimind-data
MODEL_REGISTRY_PATH=s3://agrimind-models

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agrimind123

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agrimind

# Security
JWT_SECRET=change-me-in-production
API_KEY_HEADER=X-API-Key

# External APIs (populate with real keys for production)
OPENWEATHER_API_KEY=
AGMARKNET_API_KEY=
NASA_EARTHDATA_API_KEY=

# Model Configuration
DEFAULT_CLOUD_MODEL=agrimind-7b-v1
DEFAULT_EDGE_MODEL=agrimind-18m-v1
INFERENCE_SERVICE_URL=http://localhost:8001

# Gateway Configuration
GATEWAY_RATE_LIMIT=100
GATEWAY_TIMEOUT=30
